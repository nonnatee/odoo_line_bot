<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="group_line_bot_user" model="res.groups">
            <field name="name">LINE Bot: User</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_line_bot_manager" model="res.groups">
            <field name="name">LINE Bot: Administrator</field>
            <field name="implied_ids" eval="[(4, ref('group_line_bot_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
