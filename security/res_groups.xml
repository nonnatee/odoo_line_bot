<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="module_category_line_bot" model="ir.module.category">
            <field name="name">LINE Bot</field>
            <field name="description">Manage LINE Bot Official Accounts, messages, and AI routing</field>
            <field name="sequence">30</field>
        </record>

        <record id="group_line_bot_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_line_bot"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_line_bot_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_line_bot"/>
            <field name="implied_ids" eval="[(4, ref('group_line_bot_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
