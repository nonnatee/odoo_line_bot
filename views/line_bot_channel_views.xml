<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View (Odoo 18.0+ / 19.0+ <list> syntax) -->
    <record id="view_line_bot_channel_list" model="ir.ui.view">
        <field name="name">line.bot.channel.list</field>
        <field name="model">line.bot.channel</field>
        <field name="arch" type="xml">
            <list string="LINE Bot Channels">
                <field name="name"/>
                <field name="basic_id"/>
                <field name="routing_mode"/>
                <field name="ai_engine_mode"/>
                <field name="user_count" string="Followers"/>
                <field name="conversation_count" string="Chats"/>
                <field name="status" widget="badge" decoration-success="status == 'active'" decoration-danger="status == 'error'" decoration-muted="status == 'draft'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_line_bot_channel_form" model="ir.ui.view">
        <field name="name">line.bot.channel.form</field>
        <field name="model">line.bot.channel</field>
        <field name="arch" type="xml">
            <form string="LINE Bot Channel">
                <header>
                    <button name="action_test_connection" type="object" string="Test Connection" class="btn-primary" icon="fa-check-circle"/>
                    <button name="action_set_webhook" type="object" string="Register Webhook" class="btn-secondary" icon="fa-globe"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,active"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_open_push_wizard" icon="fa-paper-plane">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Send Push</span>
                            </div>
                        </button>
                    </div>

                    <widget name="web_ribbon" title="Connected" bg_color="text-bg-success" invisible="status != 'active'"/>
                    <widget name="web_ribbon" title="Error" bg_color="text-bg-danger" invisible="status != 'error'"/>

                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="e.g. Sales Official Account"/></h1>
                        <h4><field name="bot_display_name" invisible="not bot_display_name"/></h4>
                    </div>

                    <group>
                        <group string="LINE Developers Credentials">
                            <field name="channel_id"/>
                            <field name="channel_secret" password="True"/>
                            <field name="channel_access_token" password="True"/>
                            <field name="basic_id" readonly="1" invisible="not basic_id"/>
                            <field name="bot_link" widget="url" invisible="not bot_link"/>
                        </group>
                        <group string="Routing &amp; Endpoints">
                            <field name="routing_mode" widget="radio"/>
                            <field name="auto_create_partner"/>
                            <field name="custom_webhook_base" placeholder="https://yourdomain.com"/>
                            <field name="webhook_url" widget="CopyClipboardChar" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>

                    <div class="alert alert-danger" role="alert" invisible="not error_message">
                        <strong>Error:</strong> <field name="error_message" readonly="1"/>
                    </div>

                    <notebook>
                        <page string="AI Engine &amp; Persona" name="ai_config">
                            <group>
                                <group string="Engine Mode">
                                    <field name="ai_engine_mode"/>
                                    <field name="ai_provider" invisible="ai_engine_mode == 'mcp'"/>
                                    <field name="ai_api_key" password="True" invisible="ai_engine_mode == 'mcp'"/>
                                    <field name="ai_model" invisible="ai_engine_mode == 'mcp'"/>
                                    <field name="ai_base_url" invisible="ai_engine_mode == 'mcp'"/>
                                </group>
                                <group string="AI Persona / Instructions">
                                    <field name="system_prompt" placeholder="Define how the bot speaks and behaves..."/>
                                </group>
                            </group>
                        </page>

                        <page string="Greetings &amp; Live Chat Handover" name="messages">
                            <group>
                                <group string="Automated Messages">
                                    <field name="welcome_message" placeholder="Welcome message sent on follow event..."/>
                                    <field name="handover_message" placeholder="Message sent when user requests human operator..."/>
                                </group>
                                <group string="Quick Reply Action Pills">
                                    <field name="quick_replies_json" widget="ace" options="{'mode': 'json'}"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_line_bot_channel_search" model="ir.ui.view">
        <field name="name">line.bot.channel.search</field>
        <field name="model">line.bot.channel</field>
        <field name="arch" type="xml">
            <search string="Search Channels">
                <field name="name"/>
                <field name="channel_id"/>
                <field name="basic_id"/>
                <filter string="Active &amp; Connected" name="active_channels" domain="[('status', '=', 'active')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Routing Mode" name="group_mode" context="{'group_by': 'routing_mode'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_line_bot_channel" model="ir.actions.act_window">
        <field name="name">LINE Channels</field>
        <field name="res_model">line.bot.channel</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_line_bot_channel_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure your first LINE Official Account
            </p>
            <p>
                Connect LINE Messaging API to Odoo to enable conversational AI, Live Chat bridging, and Flex cards.
            </p>
        </field>
    </record>
</odoo>
