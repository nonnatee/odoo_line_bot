<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_line_bot_user_list" model="ir.ui.view">
        <field name="name">line.bot.user.list</field>
        <field name="model">line.bot.user</field>
        <field name="arch" type="xml">
            <list string="LINE Followers &amp; Users">
                <field name="display_name"/>
                <field name="channel_id"/>
                <field name="partner_id"/>
                <field name="is_followed" widget="boolean_toggle"/>
                <field name="last_interaction_date"/>
                <field name="line_user_id"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_line_bot_user_form" model="ir.ui.view">
        <field name="name">line.bot.user.form</field>
        <field name="model">line.bot.user</field>
        <field name="arch" type="xml">
            <form string="LINE User Profile">
                <header>
                    <button name="action_refresh_profile" type="object" string="Refresh from LINE" class="btn-secondary" icon="fa-refresh"/>
                    <button name="action_send_push" type="object" string="Send Push Message" class="btn-primary" icon="fa-paper-plane"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="display_name" class="oe_edit_only"/>
                        <h1><field name="display_name"/></h1>
                        <h4><field name="line_user_id" readonly="1"/></h4>
                    </div>

                    <group>
                        <group string="Profile Information">
                            <field name="channel_id" readonly="1"/>
                            <field name="partner_id"/>
                            <field name="is_followed"/>
                            <field name="language"/>
                        </group>
                        <group string="Activity">
                            <field name="first_interaction_date" readonly="1"/>
                            <field name="last_interaction_date" readonly="1"/>
                            <field name="status_message" readonly="1"/>
                            <field name="picture_url" widget="url" invisible="not picture_url"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Conversations">
                            <field name="conversation_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="state" widget="badge" decoration-info="state == 'bot'" decoration-warning="state == 'human'"/>
                                    <field name="message_count"/>
                                    <field name="last_message_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_line_bot_user_search" model="ir.ui.view">
        <field name="name">line.bot.user.search</field>
        <field name="model">line.bot.user</field>
        <field name="arch" type="xml">
            <search>
                <field name="display_name"/>
                <field name="line_user_id"/>
                <field name="partner_id"/>
                <separator/>
                <filter string="Active Followers" name="followed" domain="[('is_followed', '=', True)]"/>
                <group>
                    <filter string="LINE Channel" name="group_channel" context="{'group_by': 'channel_id'}"/>
                    <filter string="Linked Contact" name="group_partner" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_line_bot_user" model="ir.actions.act_window">
        <field name="name">LINE Followers</field>
        <field name="res_model">line.bot.user</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_line_bot_user_search"/>
    </record>
</odoo>
